{
  "expo": {
    "name": "Smart Pantry",
    "slug": "smart-pantry",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./public/apple-icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./public/apple-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f1419"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartpantry.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Smart Pantry needs access to your camera to scan receipts and barcodes.",
        "NSPhotoLibraryUsageDescription": "Smart Pantry needs access to your photo library to upload receipt images.",
        "NSMicrophoneUsageDescription": "Smart Pantry does not use the microphone."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./public/apple-icon.png",
        "backgroundColor": "#0f1419"
      },
      "package": "com.smartpantry.app",
      "jsEngine": "hermes",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./public/icon.svg"
    },
    "plugins": [
      "expo-sqlite",
      "expo-splash-screen",
      "expo-dev-client",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Smart Pantry to access your camera to scan receipts and barcodes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Smart Pantry to access your photo library to upload receipt images."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "69de6359-283c-4970-982d-bb59f99309c2"
      }
    }
  }
}
